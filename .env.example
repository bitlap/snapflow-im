# 可选的 HOCON 环境覆盖模板；应用不自动载入本文件。
# SNAPFLOW_IM_CONFIG=/absolute/path/server.conf
SNAPFLOW_IM_HOST=127.0.0.1
SNAPFLOW_IM_PORT=8090
SNAPFLOW_IM_APP_ID=your-app
SNAPFLOW_IM_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/snapflow-im
SNAPFLOW_IM_DATABASE_USER=snapflow_im
SNAPFLOW_IM_DATABASE_PASSWORD=replace-locally
# 三个不同的随机密钥，每个至少 32 字节。
SNAPFLOW_IM_USER_JWT_SECRET=replace-with-random-user-signing-key
SNAPFLOW_IM_SERVICE_JWT_SECRET=replace-with-random-service-signing-key
SNAPFLOW_IM_CURSOR_SECRET=replace-with-random-cursor-signing-key
SNAPFLOW_IM_JWT_ISSUER=snapflow-im
# 可选：由你控制的现有业务登录鉴权端点，返回 user_id 或 data.user_id。
# SNAPFLOW_IM_INTROSPECTION_URL=https://your-business.example/api/v1/me
SNAPFLOW_IM_APNS_ENABLED=false
# APNs 开启后全部必填；私钥只挂载在服务端。
# SNAPFLOW_IM_APNS_TEAM_ID=YOURTEAMID
# SNAPFLOW_IM_APNS_KEY_ID=YOURKEYID
# SNAPFLOW_IM_APNS_TOPIC=your.ios.bundle.id
# SNAPFLOW_IM_APNS_KEY_FILE=/run/secrets/AuthKey.p8
# SNAPFLOW_IM_APNS_SANDBOX=true
